{
  "name": "@porkbot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@orpc/openapi": "1.15.1",
    "@orpc/server": "1.15.1",
    "@orpc/zod": "1.15.1",
    "@porkbot/auth": "workspace:*",
    "@porkbot/contracts": "workspace:*",
    "@porkbot/core": "workspace:*",
    "@porkbot/db": "workspace:*",
    "@porkbot/effect": "workspace:*",
    "@porkbot/health": "workspace:*",
    "@porkbot/logging": "workspace:*",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@porkbot/eslint-config": "workspace:*",
    "@porkbot/testkit": "workspace:*",
    "@porkbot/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}

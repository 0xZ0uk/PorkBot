# The api process's environment schema. Shared values come from the root
# schema; everything else here is read by apps/api alone.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, DATABASE_URL, LOG_LEVEL, PORKBOT_STORAGE_DIR, PORKBOT_SUPERVISOR_URL, PORKBOT_SUPERVISOR_TOKEN])
# The limits are read in apps/api/src/limits.ts through `limitFromEnvironment`,
# which names each variable as a string argument; teach the auditor the shape.
# @auditExtraPatterns(regex('limitFromEnvironment\(\s*env,\s*"([A-Z_]+)"'), fileTypes=[ts])

# ---

# The HTTP port. The default matches `main.ts`.
# @type=port
PORT=3001

# The absolute URL an OAuth provider redirects back to. Unset falls back to
# loopback http in `main.ts`; a deployment names its public origin here.
# @type=url(allowedProtocols=[http, https])
PORKBOT_MCP_CALLBACK_URL=

# The encrypted credential store's keyring: a comma-separated `id:base64key`
# list and the id new writes use. Both unset lock the store (typed 503s) and
# the process still boots, so neither is required. The reads happen inside
# `credentialKeyringFromEnvironment` in @porkbot/db, outside this app's source.
# @sensitive
# @auditIgnore
PORKBOT_CREDENTIAL_KEYS=

# @sensitive
# @auditIgnore
PORKBOT_CREDENTIAL_ACTIVE_KEY=

# The rate limits, body caps and stream caps from `limitsFromEnvironment`
# (apps/api/src/limits.ts). Every default below mirrors `defaultLimits` there;
# a value that is not a positive integer fails boot either way.
# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_AUTHENTICATED_PER_MINUTE=300

# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_ANONYMOUS_PER_MINUTE=60

# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_WEBHOOK_PER_MINUTE=120

# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_UPLOAD_PER_MINUTE=60

# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_PROBE_PER_MINUTE=600

# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_MAX_STREAMS_PER_ACTOR=4

# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_MAX_BODY_BYTES=1048576

# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_MAX_WEBHOOK_BODY_BYTES=262144

# Mirrors MAX_ATTACHMENT_BYTES in @porkbot/core.
# @type=number(isInt=true, min=1)
PORKBOT_LIMIT_MAX_UPLOAD_BYTES=8388608

# The web host's environment schema (`dist/host/main.js`; Vite's dev server and
# the SPA build read no environment variables). Shared values come from the
# root schema.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, LOG_LEVEL])

# ---

# The static host's port.
# @type=port
PORT=3000

# The directory the built SPA is served from. Unset defaults to `dist/client`
# next to the host process.
PORKBOT_WEB_ROOT=

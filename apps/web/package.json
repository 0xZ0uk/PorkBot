{
  "name": "@porkbot/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    }
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc -p tsconfig.build.json",
    "serve": "varlock run -- node dist/host/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@porkbot/contracts": "workspace:*",
    "@porkbot/core": "workspace:*",
    "@porkbot/health": "workspace:*",
    "@porkbot/logging": "workspace:*",
    "@porkbot/tokens": "workspace:*",
    "@porkbot/ui": "workspace:*",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.56",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@porkbot/eslint-config": "workspace:*",
    "@porkbot/testkit": "workspace:*",
    "@porkbot/typescript-config": "workspace:*",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "varlock": "1.20.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}

{
  "name": "@porkbot/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@porkbot/adapter-kit": "workspace:*",
    "@porkbot/adapters": "workspace:*",
    "@porkbot/core": "workspace:*",
    "@porkbot/db": "workspace:*",
    "@porkbot/effect": "workspace:*",
    "@porkbot/health": "workspace:*",
    "@porkbot/logging": "workspace:*",
    "effect": "3.22.2",
    "graphile-worker": "0.18.0"
  },
  "devDependencies": {
    "@porkbot/eslint-config": "workspace:*",
    "@porkbot/testkit": "workspace:*",
    "@porkbot/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}

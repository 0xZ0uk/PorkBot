# The worker process's environment schema. Shared values come from the root
# schema; everything else here is read by apps/worker alone.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, DATABASE_URL, LOG_LEVEL, PORKBOT_CREDENTIAL_KEYS, PORKBOT_CREDENTIAL_ACTIVE_KEY])
# The webhook credential is read by name through the environment credential
# store (`credentialName` in main.ts); teach the auditor the shape.
# @auditExtraPatterns(regex('credentialName:\s*"([A-Z_]+)"'), fileTypes=[ts])

# ---

# The health surface's port.
# @type=port
PORT=3002

# The run-notification webhook (provider E8). Unset keeps the offline emulator
# and records deliveries with nothing configured; set means the HTTPS provider
# delivers, with its key read from the generic credential store below.
# @type=url(allowedProtocols=[http, https])
PORKBOT_NOTIFICATION_WEBHOOK_URL=

# The webhook provider's credential, read by the environment credential store
# under this name when a webhook URL is configured.
# @sensitive
PORKBOT_NOTIFICATION_WEBHOOK_KEY=

# The absolute web origin a notification's link is built from. Unset falls back
# to loopback with a warning, so a deployment that cares says so.
# @type=url(allowedProtocols=[http, https])
PORKBOT_WEB_ORIGIN=

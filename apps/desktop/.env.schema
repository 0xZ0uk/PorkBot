# The desktop shell's environment schema (slice 11.6). The Electron process
# reads these at launch; a packaged build without them still runs and simply
# reports that no signed update feed is configured. Shared values come from the
# root schema.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, LOG_LEVEL])

# ---

# The base URL the release publishes `update.json` under. HTTPS only: the
# manifest and the artifact it signs are the one code-loading path the app has.
# @type=url(allowedProtocols=[https])
PORKBOT_DESKTOP_UPDATE_FEED=

# The Ed25519 public key update manifests must be signed with, as base64 SPKI
# DER or PEM. It is a public key, not a secret; the private half lives with the
# release and never in this repository.
PORKBOT_DESKTOP_UPDATE_PUBLIC_KEY=

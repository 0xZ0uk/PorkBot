{
  "name": "@porkbot/desktop",
  "productName": "PorkBot",
  "version": "0.0.0",
  "private": true,
  "description": "The connect-only desktop client of a PorkBot server.",
  "author": "PorkBot contributors",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@porkbot/core": "workspace:*",
    "@porkbot/tokens": "workspace:*",
    "@porkbot/web": "workspace:*"
  },
  "devDependencies": {
    "@porkbot/eslint-config": "workspace:*",
    "@porkbot/testkit": "workspace:*",
    "@porkbot/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "44.4.3",
    "eslint": "10.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "LOG_LEVEL",
    "PORKBOT_LIMIT_AUTHENTICATED_PER_MINUTE",
    "PORKBOT_LIMIT_ANONYMOUS_PER_MINUTE",
    "PORKBOT_LIMIT_WEBHOOK_PER_MINUTE",
    "PORKBOT_LIMIT_PROBE_PER_MINUTE",
    "PORKBOT_LIMIT_MAX_STREAMS_PER_ACTOR",
    "PORKBOT_LIMIT_MAX_BODY_BYTES",
    "PORKBOT_LIMIT_MAX_WEBHOOK_BODY_BYTES"
  ],
  "globalDependencies": [".nvmrc", "quarantine.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTKIT_DATABASE_URL",
        "TESTKIT_HARNESS_STATE",
        "TESTKIT_POSTGRES_IMAGE"
      ],
      "cache": false,
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "PORKBOT_STORAGE_DIR",
    "PORKBOT_MCP_CALLBACK_URL",
    "PORKBOT_WEB_ROOT",
    "GITHUB_ACTIONS",
    "GITHUB_STEP_SUMMARY"
  ]
}

# PorkBot's reverse proxy (slice 12.2, PRD decision 32 and story 4).
#
# One origin serves the SPA, the API and the streaming subscriptions, so the
# session cookie is same-site, the origin checks the auth layer applies are
# about this origin, and CORS never enters the picture. Caddy terminates TLS
# for the public origin; nothing else in the stack is published.
#
# This file is shipped rather than documented because streaming is what a
# misconfigured proxy breaks silently: a response buffer between the API and
# the browser turns token-by-token output into one pause followed by the whole
# answer, with no error anywhere. Three things hold the contract here:
#
#   - `flush_interval -1` on the API route. Caddy also flushes
#     `text/event-stream` responses immediately by default (and responses with
#     no Content-Length), so this asserts the intent instead of relying on it.
#   - The timeouts below. Client reads are capped, keep-alive idleness is
#     capped, and the wait for the API's response headers is capped. There is
#     deliberately no server `write` timeout: it bounds a whole response, and a
#     token stream is expected to stay open.
#   - No `encode` anywhere: compression buffers, and this origin serves the
#     API's stream on the same listener as the SPA.
#
# `Last-Event-ID` needs no directive: Caddy passes request headers through
# untouched, and the API is the only thing that validates the cursor.
#
# The two upstream variables exist so the same file serves the deployment
# (`api:3001`, `web:3000` over the compose network) and the local stack
# (`http://localhost:8080` over loopback). The site variable is the public
# origin from deploy/.env in production and a loopback origin locally.
{
	# Client-side caps. `read_header` and `read_body` bound a slow request
	# before it reaches the API; `idle` bounds an idle keep-alive connection
	# between requests. A streaming response is not an idle connection.
	servers {
		timeouts {
			read_header 10s
			read_body 5m
			idle 5m
		}
	}
}

# The one public origin. In a deployment this is the https origin from
# deploy/.env (PORKBOT_AUTH_ORIGIN), for which Caddy obtains the certificate
# automatically; the local stack passes an http loopback origin and serves it
# without TLS, because there is nothing to terminate on loopback.
{$PORKBOT_SITE_ADDRESS:http://localhost:8080} {
	# The mounts the API owns: the five the web dev server forwards
	# (apps/web/vite.config.ts), the inbound webhook ingress providers call
	# directly, and the health probes so the public health paths report the
	# API and never the static host. A request that matches none of them is
	# the SPA.
	@api path /healthz /healthz/* /livez /readyz /rpc/* /api/* /files/* /oauth/* /webhooks/* /threads/*/attachments

	handle @api {
		reverse_proxy {$PORKBOT_API_UPSTREAM:api:3001} {
			# Low-latency mode: flush every write as the API makes it, so a
			# token frame reaches the browser when it is produced.
			flush_interval -1
			transport http {
				dial_timeout 5s
				# How long to wait for the API to answer before streaming
				# starts; a subscription's frames are not part of this.
				response_header_timeout 30s
			}
		}
	}

	handle {
		reverse_proxy {$PORKBOT_WEB_UPSTREAM:web:3000} {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}
}

# The container healthcheck's listener, on a loopback port that is never
# published. It answers only if the config loaded and the API route in it
# works, so `docker compose ps` shows a broken proxy-to-API path as unhealthy.
http://127.0.0.1:8899 {
	handle /healthz {
		reverse_proxy {$PORKBOT_API_UPSTREAM:api:3001}
	}

	handle {
		respond 404
	}
}

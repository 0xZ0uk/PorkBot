# PorkBot's single deployment environment file (PRD story 2).
#
# This is the template, not the file you start. `pnpm deploy:setup` renders it
# into `deploy/.env` (mode 0600, git-ignored), replacing every `@` sentinel
# with a freshly generated secret or with a value from the command line:
#
#   pnpm deploy:setup --origin https://bots.example.com
#   # or, on a host that has never run it:
#   pnpm deploy:up --origin https://bots.example.com
#
# `pnpm deploy:check` validates `deploy/.env` without touching Docker, and
# `pnpm deploy:up` refuses to start the stack while any rule below is broken.
# Docker Compose reads the file through `--env-file`, and the compose file
# itself refuses a missing required value, so a hand-run `docker compose` fails
# loudly too. Never commit `deploy/.env`; the generated secrets live there.
#
# Values are unquoted and URL/`$`-safe by construction. The only keys an
# operator is expected to edit after setup are the optional provider settings
# (mail, the notification webhook, the credential proxy) and the computer
# sizing.

# --- Release identity -------------------------------------------------------

# Tags every built image. Filled from the checkout's git SHA at setup time
# (override with `--tag`); never `latest`.
PORKBOT_IMAGE_TAG=@image-tag

# Where the published web and API ports bind. The default is loopback: the
# reverse-proxy contract (slice 12.2) owns the public origin, and until it is
# configured the stack is reached over an SSH tunnel.
PORKBOT_BIND_ADDRESS=127.0.0.1

PORKBOT_WEB_PORT=3000

PORKBOT_API_PORT=3001

# debug | info | warn | error. The logger refuses to boot on anything else.
LOG_LEVEL=info

# The Docker daemon socket the supervisor mounts (the only socket mount in the
# stack). Rootless Docker or a non-standard daemon names its own path here.
PORKBOT_DOCKER_SOCKET=/var/run/docker.sock

# --- Database -----------------------------------------------------------------

# The Postgres superuser, its database, and the three passwords the stack uses.
# `pnpm deploy:setup` generates each password independently; they are URL-safe
# hex because they are spliced into connection strings. Changing these after
# the first boot does not change the running cluster's roles: rotate with
# `ALTER ROLE` and then update the file.
PORKBOT_POSTGRES_USER=porkbot

PORKBOT_POSTGRES_DB=porkbot

PORKBOT_POSTGRES_PASSWORD=@generate

# The api role's password, applied by the migrate one-shot on every start.
PORKBOT_API_DB_PASSWORD=@generate

# The worker role's password, applied by the migrate one-shot on every start.
PORKBOT_WORKER_DB_PASSWORD=@generate

# --- Public origin and operator auth -------------------------------------------

# The one public origin the browser uses: the base for session cookies, reset
# links and the MCP OAuth callback. Must be an absolute https origin (http is
# accepted only for loopback). Filled from `--origin`.
PORKBOT_AUTH_ORIGIN=@origin

# The origin notification links point at. Defaults to PORKBOT_AUTH_ORIGIN.
PORKBOT_WEB_ORIGIN=@web-origin

# The MCP OAuth consent callback. Defaults to
# `<PORKBOT_AUTH_ORIGIN>/oauth/mcp/callback`; override it only if the proxy
# rewrites that path.
PORKBOT_MCP_CALLBACK_URL=@mcp-callback-url

# Signs sessions and tokens. Generated; rotating it signs every session out.
PORKBOT_AUTH_SECRET=@generate

# --- Transactional mail (optional) ----------------------------------------------

# The reset/verification mail provider. All three or none: unset, sign-in and
# sign-out still work and reset mail is refused with a typed configuration
# error. The key is read by name from the environment, never written into an
# image or a log.
PORKBOT_MAIL_ENDPOINT=
PORKBOT_MAIL_FROM=
PORKBOT_MAIL_KEY=

# --- Supervisor and computers ---------------------------------------------------

# The process credential the API presents to the supervisor's internal surface.
# Generated; both processes read it from this file.
PORKBOT_SUPERVISOR_TOKEN=@generate

# Signs the short-lived screen capabilities. v1.0 ships no screen surface, so
# the path stays closed; generated here so a later screen slice is never
# half-configured.
PORKBOT_SCREEN_TOKEN_SECRET=@generate

# offline keeps every bot on the in-process emulator (no daemon, no network).
# docker runs real machines from PORKBOT_COMPUTER_IMAGE; daytona runs cloud
# sandboxes and also needs PORKBOT_COMPUTER_ENDPOINT and PORKBOT_COMPUTER_TOKEN.
# A bot may select any kind this deployment configured; an unconfigured one is
# refused rather than silently replaced.
PORKBOT_COMPUTER_PROVIDER=offline

# The machine image both real providers boot: a POSIX shell, the coreutils
# `timeout` the command budget uses, and the browser helper protocol. Required
# when the provider is not `offline`.
PORKBOT_COMPUTER_IMAGE=

# The cloud control-plane connection, required together with an image when the
# provider is `daytona`.
PORKBOT_COMPUTER_ENDPOINT=
PORKBOT_COMPUTER_TOKEN=

# One bot's share of the host. The host floor and the arithmetic are in
# README.md ("Single-host deployment"): 4 vCPU / 8 GB for the stack, plus
# roughly 2 GB and 50 GB+ of disk per bot, with 50 GB+ more for images. Raise
# these only after raising the host.
PORKBOT_COMPUTER_CPUS=1
PORKBOT_COMPUTER_MEMORY_MB=2048
PORKBOT_COMPUTER_DISK_MB=10240

# A machine whose last command is older than this is parked; its home volume
# survives. Zero disables the idle sweep.
PORKBOT_COMPUTER_IDLE_MS=900000

# The credential proxy (slice 7.8). All three or none: configured, every
# Docker computer gets a sidecar on its isolated network, run credentials live
# on the sidecar's own layer, and the sandbox carries only a short-lived
# capability. The supervisor refuses a partial configuration at boot, so these
# stay empty by default; enable the proxy with
# `pnpm deploy:setup --proxy-image <ref> --egress-network <name>`, which
# generates the capability token and keeps the rest of the file as it is.
PORKBOT_COMPUTER_PROXY_IMAGE=@proxy-image
PORKBOT_PROXY_TOKEN_SECRET=@generate-if-proxy
PORKBOT_COMPUTER_EGRESS_NETWORK=@proxy-egress-network

# --- Run notifications (optional) -------------------------------------------------

# The HTTPS webhook run-liveness notifications are delivered to. Unset keeps
# the offline emulator (deliveries are recorded, nothing leaves the host).
PORKBOT_NOTIFICATION_WEBHOOK_URL=
PORKBOT_NOTIFICATION_WEBHOOK_KEY=

# --- Credential store ---------------------------------------------------------

# The AES-256 keyring that encrypts stored provider credentials at rest: a
# comma-separated `id:base64key` list and the id new writes use. Generated.
# To rotate: add `<new id>:<new key>`, set PORKBOT_CREDENTIAL_ACTIVE_KEY to the
# new id, restart, run the store's rotate, then drop the old entry.
PORKBOT_CREDENTIAL_KEYS=@generate-keyring
PORKBOT_CREDENTIAL_ACTIVE_KEY=k1

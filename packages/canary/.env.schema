# The canary's environment schema. The canary is an operator tool, not a
# service: it reaches a deployment's supervisor with the same generic
# connection the api uses, and it delivers a failure through the same
# notification webhook the worker uses. Every value here is read by
# src/canary/cli.ts and src/canary/notify.ts; nothing is provider-specific.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, PORKBOT_SUPERVISOR_URL, PORKBOT_SUPERVISOR_TOKEN])
# The commands read their environment through a context object
# (`context.env["KEY"]`), which is what makes the CLI testable, and the webhook
# credential is read by name through the environment credential store
# (`credentialName` in src/notify.ts). Teach the auditor both shapes.
# @auditExtraPatterns(regex('env\["([A-Z_]+)"\]'), regex('credentialName:\s*"([A-Z_]+)"'), fileTypes=[ts])

# ---

# The supervisor's origin and process credential, imported from the root schema
# because the api configures the same pair for the same service.

# The canary's failure notification (provider E8). Unset keeps the offline
# emulator and the error log; set delivers through the HTTPS provider with its
# key read from the generic credential store below.
# @type=url(allowedProtocols=[http, https])
PORKBOT_NOTIFICATION_WEBHOOK_URL=

# @sensitive
PORKBOT_NOTIFICATION_WEBHOOK_KEY=

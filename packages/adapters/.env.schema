# The credential proxy sidecar's environment schema (`dist/proxy-main.js`). The
# sidecar is spawned inside a machine container with these values injected by
# the computer provider, so every one it requires is required here too. A
# deployment configures the sidecar from the supervisor schema, not from
# packages/adapters' own environment.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, LOG_LEVEL])
# The sidecar settings are read in src/proxy-main.ts through `required("KEY")`
# and direct `env["KEY"]` lookups; teach the auditor both shapes.
# @auditExtraPatterns(regex('required\("([A-Z_]+)"\)'), regex('env\["([A-Z_]+)"\]'), fileTypes=[ts])

# ---

# The capability-signing key, shared with the supervisor's configuration.
# @sensitive @required
PORKBOT_PROXY_TOKEN_SECRET=

# The machine and bot this sidecar was started for; both are part of every
# signed capability's binding.
# @required
PORKBOT_PROXY_COMPUTER_ID=

# @required
PORKBOT_PROXY_BOT_ID=

# Where the supervisor writes this computer's grant, through the daemon's
# archive API.
# @required
PORKBOT_PROXY_GRANT_DIR=

# The sidecar's listener; zeroes are not a deployment's choice, so the port
# floor stays above them.
# @type=domain(allowIp=true)
PORKBOT_PROXY_HOST=0.0.0.0

# @type=port(min=1)
PORKBOT_PROXY_PORT=8321

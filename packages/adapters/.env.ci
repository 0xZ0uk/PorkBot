# Committed fixtures for `APP_ENV=ci` only (see .env.schema). The `env` CI tier
# loads these to prove the sidecar's schema resolves without a machine: the
# values are placeholders, and the sidecar only ever starts inside a container
# where the supervisor injects the real ones.
PORKBOT_PROXY_TOKEN_SECRET=ci-fixture-proxy-capability-placeholder
PORKBOT_PROXY_COMPUTER_ID=00000000-0000-0000-0000-000000000000
PORKBOT_PROXY_BOT_ID=00000000-0000-0000-0000-000000000000
PORKBOT_PROXY_GRANT_DIR=/ci-fixture/grants

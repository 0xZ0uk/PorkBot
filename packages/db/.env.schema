# The migration runner's environment schema (`pnpm db:migrate`, the one-shot
# compose service). The runner needs no LOG_LEVEL. Shared values come from the
# root schema.

# @currentEnv=$APP_ENV
# @defaultRequired=infer
# @defaultSensitive=false
# @import(../../, pick=[APP_ENV, DATABASE_URL])
# The role passwords are read in src/roles.ts through their exported constant
# names (`apiRolePasswordEnvVar`, `workerRolePasswordEnvVar`), which are the
# string literals below; teach the auditor the shape.
# @auditExtraPatterns(regex('(?:api|worker)RolePasswordEnvVar\s*=\s*"([A-Z_]+)"'), fileTypes=[ts])

# ---

# The two service roles' passwords, applied with `setRolePasswords` after the
# migrations. Either may be absent, and an absent role is left alone, so a
# deployment that authenticates another way is not fought by this command.
# @sensitive
PORKBOT_API_DB_PASSWORD=

# @sensitive
PORKBOT_WORKER_DB_PASSWORD=

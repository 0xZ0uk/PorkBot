{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": ["FLAKE_ATTEMPTS_FILE", "FLAKE_LEDGER_FILE"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": ["FLAKE_ATTEMPTS_FILE", "FLAKE_LEDGER_FILE"]
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": [
        "DOCKER_HOST",
        "TESTKIT_DATABASE_URL",
        "TESTKIT_HARNESS_STATE",
        "TESTKIT_POSTGRES_IMAGE"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"]
    }
  }
}

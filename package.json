{
  "name": "porkbot",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.4",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "canary:notify": "node packages/canary/src/cli.ts notify",
    "canary:run": "node packages/canary/src/cli.ts run",
    "canary:sweep": "node packages/canary/src/cli.ts sweep",
    "db:generate": "pnpm --filter @porkbot/db db:generate",
    "db:migrate": "pnpm --filter @porkbot/db db:migrate",
    "dependencies:check": "node packages/testkit/src/dependencies/cli.ts check",
    "dependencies:diff": "node packages/testkit/src/dependencies/cli.ts diff --base origin/main",
    "desktop:package": "node packages/testkit/src/release/cli.ts package",
    "desktop:smoke": "node packages/testkit/src/release/cli.ts smoke",
    "deploy:check": "node packages/testkit/src/deployment/cli.ts check",
    "deploy:backup": "node packages/testkit/src/deployment/cli.ts backup",
    "deploy:down": "node packages/testkit/src/deployment/cli.ts down",
    "deploy:exec": "node packages/testkit/src/deployment/cli.ts exec",
    "deploy:logs": "node packages/testkit/src/deployment/cli.ts logs",
    "deploy:measure": "node packages/testkit/src/deployment/cli.ts measure",
    "deploy:rollback": "node packages/testkit/src/deployment/cli.ts rollback",
    "deploy:schedule": "node packages/testkit/src/deployment/cli.ts schedule",
    "deploy:setup": "node packages/testkit/src/deployment/cli.ts setup",
    "deploy:status": "node packages/testkit/src/deployment/cli.ts status",
    "deploy:up": "node packages/testkit/src/deployment/cli.ts up",
    "deploy:upgrade": "node packages/testkit/src/deployment/cli.ts upgrade",
    "dev": "turbo run dev",
    "docs:check": "node packages/testkit/src/docs/cli.ts check",
    "env:check": "node scripts/env-check.mjs",
    "image-sizes:check": "node packages/testkit/src/image-sizes/cli.ts check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "posture:check": "node packages/testkit/src/posture/cli.ts check",
    "quarantine:check": "node packages/testkit/src/quarantine/cli.ts check",
    "release:bump": "node packages/testkit/src/release/cli.ts bump",
    "release:notes": "node packages/testkit/src/release/cli.ts notes",
    "stack:down": "node scripts/stack.mjs down",
    "stack:logs": "node scripts/stack.mjs logs",
    "stack:status": "node scripts/stack.mjs status",
    "stack:up": "node scripts/stack.mjs up",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "testkit:benchmark": "node packages/testkit/src/harness/cli.ts benchmark",
    "testkit:destroy": "node packages/testkit/src/harness/cli.ts destroy",
    "testkit:migrate": "node packages/testkit/src/harness/cli.ts migrate",
    "testkit:snapshot": "node packages/testkit/src/harness/cli.ts snapshot",
    "testkit:start": "node packages/testkit/src/harness/cli.ts start",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "varlock": "1.20.0"
  }
}
